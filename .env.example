# Copy to .env and fill in. Never commit the real .env.

# --- standalone bot (app/bot.py) ---
TELEGRAM_TOKEN=
DIET_DB=/opt/nutrigent/data/diet.db
OPENAI_API_KEY=
# Comma-separated Telegram user IDs allowed to use the bot. Empty = everyone.
ALLOWED_TELEGRAM_IDS=

# --- Hermes gateway (~/.hermes/.env) ---
# Hermes can run shell commands on the server, so never open it to everyone:
# GATEWAY_ALLOW_ALL_USERS=false
# TELEGRAM_ALLOWED_USERS=<id1>,<id2>
